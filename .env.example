# Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# RapidAPI / AeroDataBox
RAPIDAPI_KEY=your_rapidapi_key_here
AERODATABOX_HOST=aerodatabox.p.rapidapi.com

# OpenWeatherMap
WEATHER_API_KEY=your_openweathermap_api_key_here

# ExchangeRate API
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# Geoapify
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Hugging Face embeddings for policy RAG
HF_TOKEN=your_hugging_face_token_here
HF_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Local policy vector store
CHROMA_DB_PATH=./chroma_db
POLICY_DOCS_PATH=policy_docs
POLICY_COLLECTION_NAME=travel_policy_docs

# Agent mode pacing
AGENT_TOOL_DELAY_SECONDS=2.0
AGENT_TOOL_RETRIES=1
